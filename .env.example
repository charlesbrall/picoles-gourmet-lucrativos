# ============================================
# VARIÁVEIS DE AMBIENTE - Picolés Gourmet Lucrativos
# Configure estas no Vercel Dashboard > Settings > Environment Variables
# ============================================

# PAGAR.ME (Stone) - Chave secreta da API v5 (sk_...)
# Obtenha em: https://dashboard.pagar.me/
PAGARME_SECRET_KEY="sk_c7d297aef3004ec79065304a6e6ec688"

# RESEND - Para envio automático de e-mails de acesso
# Crie conta gratuita em: https://resend.com (3.000 emails/mês grátis)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Picolé Lucrativo <onboarding@resend.dev>"

# SUPABASE - Banco de dados para pedidos e configurações
# Crie projeto em: https://supabase.com
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# OU use a Service Role Key (mais permissiva, apenas server-side):
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# URL do entregável (área de membros onde o cliente acessa após pagamento)
DELIVERABLE_URL="https://apppicolelucratico20.netlify.app/"

# APP URL - URL onde o app está hospedado (preenchido automaticamente pelo Vercel)
# APP_URL="https://seu-projeto.vercel.app"

# ============================================
# INSTRUÇÕES DE CONFIGURAÇÃO NO VERCEL:
# ============================================
# 1. Acesse https://vercel.com/dashboard
# 2. Importe este repositório
# 3. Vá em Settings > Environment Variables
# 4. Adicione cada variável acima (Name = chave, Value = valor)
# 5. Selecione os ambientes: Production, Preview, Development
# 6. Deploy!

